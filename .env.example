# Compatible chat / embedding provider. Do not commit real keys.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# 用于网页 AI 对话；仅放在本地 .env，绝不写入前端代码。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 网页模型下拉菜单。Key 仅保存在此 .env，不会发送给浏览器。
# 配置后，它会取代上方的兼容 DeepSeek/LLM 默认项；未填写则沿用旧配置。
CHAT_MODELS=[]
# XPeach models shown in the chat-model selector.
XPEACH_API_KEY=
XPEACH_BASE_URL=https://fast.xpeach.codes/v1
XPEACH_CHAT_MODEL=
XPEACH_CHAT_LABEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Local PostgreSQL + pgvector. docker compose applies the migration on first start.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://final_review:change-me@127.0.0.1:5432/final_review
AUTH_MODE=database
AUTH_COOKIE_NAME=final_review_access
# Local HTTP development only. Set true behind HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_DAYS=30
# Generate a dedicated random value of at least 32 bytes for email verification.
AUTH_EMAIL_CODE_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_SENDER=
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional bearer token; default bind is localhost. Set token before sharing.
API_TOKEN=
MAX_UPLOAD_MB=10
# Optional absolute executable paths; otherwise use PATH / standard install locations.
POPPLER_EXECUTABLE=
LIBREOFFICE_EXECUTABLE=
TESSERACT_EXECUTABLE=
TESSDATA_PREFIX=
# Visual slide reading: choose a configured CHAT_MODELS provider id and vision model.
MATERIAL_VISION_ENABLED=true
MATERIAL_VISION_MODEL_ID=default
MATERIAL_VISION_MODEL=qwen3-vl-plus
MATERIAL_VISION_TIMEOUT=90
MATERIAL_VISION_REPAIRS=1
MATERIAL_VISION_CONCURRENCY=4
MATERIAL_FILE_CONCURRENCY=5
MATERIAL_HYBRID_ENABLED=true
# Opt-in only; existing uploads retain their original strategy.
MATERIAL_PPTX_PARSE_MODE=text_only_polished
# Saved parse_strategy text-polish-v1 only. Integer 1..500, default 120.
# Does not change the visual/OCR/render cap (MAX_PRESENTATION_SLIDES=80).
MATERIAL_TEXT_MAX_SLIDES=120
# Explicit save is enabled; edited text is not yet synchronized to retrieval/knowledge.
MATERIAL_NOTE_EDIT_ENABLED=true
# Complete learning notes with source-grounded explanations and semantic review.
MATERIAL_NOTE_POLISH_MODEL_ID=default
# Optional model name on the selected provider; empty uses that provider's configured model.
MATERIAL_NOTE_POLISH_MODEL=
MATERIAL_NOTE_POLISH_TIMEOUT=180
MATERIAL_NOTE_POLISH_MAX_OUTPUT_TOKENS=16384
MATERIAL_NOTE_POLISH_CONCURRENCY=3
MATERIAL_NOTE_POLISH_BATCH_BLOCKS=24
MATERIAL_NOTE_POLISH_PROMPT_VERSION=material-learning-v2
MATERIAL_NOTE_POLISH_REVIEW_MODE=always
MATERIAL_PREVIEW_CONCURRENCY=2
MATERIAL_IMAGE_CONCURRENCY=1
MATERIAL_CONVERSION_CONCURRENCY=2
MATERIAL_VISION_GLOBAL_CONCURRENCY=4
EMBEDDING_REQUEST_CONCURRENCY=2
KNOWLEDGE_TASK_CONCURRENCY=2
# Independent automatic course knowledge builds after material parsing.
KNOWLEDGE_MODEL_ID=default
KNOWLEDGE_MODEL_TIMEOUT=180
KNOWLEDGE_MAX_OUTPUT_TOKENS=8192
KNOWLEDGE_EXTRACTOR_VERSION=course-knowledge-v1
KNOWLEDGE_BLOCK_CHARS=10000
KNOWLEDGE_BLOCK_PAGES=4
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_SIMILARITY=0.65
TOP_K=5
RETRIEVAL_CANDIDATES=20
MIN_SIMILARITY=0.25
MAX_REPAIRS=1
MODEL_TIMEOUT=60
# 笔记 worker 的单次模型请求预算，与网页聊天分开配置。
NOTE_MODEL_TIMEOUT=120
NOTE_MODEL_MAX_RETRIES=1
QUIZ_MODEL_TIMEOUT=120
QUIZ_MAX_REPAIRS=2
# Export files are private; never mount this directory as a static URL.
EXPORTS_DIR=exports
# Empty uses bundled Pandoc and Playwright-managed Chromium.
EXPORT_PANDOC_EXECUTABLE=
EXPORT_CHROMIUM_EXECUTABLE=

# Quiz generation: bounded batches and explicit output token budget
QUIZ_MAX_OUTPUT_TOKENS=16384
QUIZ_CHOICE_BATCH_SIZE=5
QUIZ_WRITTEN_BATCH_SIZE=2

# Optional internal pipeline traces. Missing keys leave parsing operational.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=development
# Standalone catalog scheduler; leave disabled until isolated acceptance passes.
# All catalog service instances must use the same concurrency setting.
CATALOG_SCHEDULER_ENABLED=false
CATALOG_SCAN_INTERVAL_SECONDS=10
CATALOG_RECONCILE_INTERVAL_SECONDS=60
CATALOG_QUIET_WINDOW_SECONDS=60
CATALOG_MAX_WAIT_SECONDS=300
CATALOG_MAX_CONCURRENCY=1
CATALOG_PAGE_SIZE=100
CATALOG_MODEL_ID=default
