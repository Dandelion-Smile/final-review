# Compatible chat / embedding provider. Do not commit real keys.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# 用于网页 AI 对话；仅放在本地 .env，绝不写入前端代码。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 网页模型下拉菜单。Key 仅保存在此 .env，不会发送给浏览器。
# 配置后，它会取代上方的兼容 DeepSeek/LLM 默认项；未填写则沿用旧配置。
CHAT_MODELS=[]
# XPeach models shown in the chat-model selector.
XPEACH_API_KEY=
XPEACH_BASE_URL=https://fast.xpeach.codes/v1
XPEACH_CHAT_MODEL=
XPEACH_CHAT_LABEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Local PostgreSQL + pgvector. docker compose applies the migration on first start.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://final_review:change-me@127.0.0.1:5432/final_review
AUTH_MODE=database
AUTH_COOKIE_NAME=final_review_access
# Local HTTP development only. Set true behind HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_DAYS=30

# Optional bearer token; default bind is localhost. Set token before sharing.
API_TOKEN=
MAX_UPLOAD_MB=10
TOP_K=5
RETRIEVAL_CANDIDATES=20
MIN_SIMILARITY=0.25
MAX_REPAIRS=1
MODEL_TIMEOUT=60
